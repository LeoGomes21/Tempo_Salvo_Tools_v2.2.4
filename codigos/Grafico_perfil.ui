           <string notr="true">QPushButton {
    transition: all 0.2s ease; /* Suaviza todas as transições de estado */
}

QPushButton:hover {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #00f7ff,
        stop:0.7 #00d9ff,
        stop:1 #ffffff); /* Gradiente com a parte inferior mais clara */
    border: 1px solid #00b3cc; /* Borda azul neon */
    border-radius: 4px; /* Cantos arredondados */
    /* Combina brilho externo com um efeito de luz interna na parte inferior */
    box-shadow: 0 0 25px rgba(0, 247, 255, 1), inset 0 -10px 15px rgba(255, 255, 255, 0.8);
}

QPushButton:pressed {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:0, y2:1,
        stop:0 #00d9ff,
        stop:1 #00b3cc); /* Gradiente um pouco mais escuro para o pressionado */
    border: 1px solid #0099b3; /* Borda mais escura */
    box-shadow: inset 0px 4px 8px rgba(0, 247, 255, 0.8); /* Sombra interna para simular o clique */
    transform: scale(0.98); /* Leve redução no tamanho */
}
