          <property name="styleSheet">
           <string notr="true">QPushButton {
    /* Mantém o estilo original do botão */
    transition: all 0.2s ease; /* Suaviza todas as transições de estado */
}

QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #ffcc99, stop:1 #ff9966); /* Gradiente suave em tons de laranja claro */
    border: 1px solid #ff6600; /* Borda laranja mais escura */
    border-radius: 4px; /* Cantos arredondados */
    box-shadow: 0px 4px 8px rgba(255, 165, 0, 0.8); /* Sombra laranja brilhante e levemente deslocada para dar profundidade */
}

QPushButton:pressed {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 #ff9966, stop:1 #ff6600); /* Gradiente mais escuro para efeito pressionado */
    border: 1px solid #cc5200; /* Borda laranja ainda mais escura */
    box-shadow: inset 0px 4px 8px rgba(255, 165, 0, 0.8); /* Sombra interna para dar a impressão de que o botão foi pressionado */
    transform: scale(0.98); /* Leve redução no tamanho para simular o pressionar */
}
</string>
